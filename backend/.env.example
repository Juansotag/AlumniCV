# Variables de entorno — AlumniCV Backend
# Copiar este archivo a .env y rellenar los valores reales

# Servidor (Railway lo inyecta automáticamente en producción)
PORT=8000

# Supabase — Auth + Storage + Base de datos
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Base de datos Postgres (la misma instancia que usa Supabase)
DATABASE_URL=postgresql://postgres:contraseña-aqui@db.tu-proyecto.supabase.co:5432/postgres

# IA — Anthropic (assessment de CV, generación de CV/cover letter/correo)
ANTHROPIC_API_KEY=tu-anthropic-api-key-aqui

# CORS — URL del frontend en producción
FRONTEND_URL=https://tu-frontend.railway.app
